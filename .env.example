# Udyking FIS - environment configuration
# Copy this file to .env and fill in your values:  cp .env.example .env

# PostgreSQL connection string.
# LOCAL (Homebrew): postgresql://s@localhost:5432/udyking_fis
# PRODUCTION (Vercel): use a free Neon Postgres database -> https://neon.tech
DATABASE_URL="postgresql://s@localhost:5432/udyking_fis?sslmode=disable"

# Secret used to sign session tokens. Use a long random string in production:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret-string"
